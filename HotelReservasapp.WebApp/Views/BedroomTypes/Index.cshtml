@model IEnumerable<HotelReservasapp_.WebApp.Models.ViewModels.BedroomTypes.BedroomTypeViewModel>

@{
    ViewData["Title"] = "Tipos de habitaciones";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Tipos de habitaciones</h2>
            <p class="text-muted mb-0">
                Mantenimiento de tipos y sus características.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            Registrar tipo
        </a>
    </div>

    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="alert alert-success">@success</div>
    }

    <div class="card shadow-sm">
        <div class="card-body">

            @if (!Model.Any())
            {
                <p class="text-muted mb-0">
                    No hay tipos de habitaciones registrados.
                </p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Nombre</th>
                                <th>Características</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var type in Model)
                            {
                                <tr>
                                    <td>@type.Id</td>
                                    <td>@type.Nombre</td>
                                    <td>
                                        @(string.IsNullOrWhiteSpace(type.Caracteristicas)
                                            ? "Sin características"
                                            : type.Caracteristicas)
                                    </td>
                                    <td class="text-end">
                                        <a asp-action="Edit"
                                           asp-route-id="@type.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Editar
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            }

        </div>
    </div>
</div>
