@model HotelReservasapp_.WebApp.Models.ViewModels.BedroomTypes.BedroomTypeViewModel

@{
    ViewData["Title"] = "Registrar tipo de habitación";
}

<div class="container mt-4">
    <h2>Registrar tipo de habitación</h2>
    <p class="text-muted">Defina un nuevo tipo de habitación.</p>

    <div class="card shadow-sm">
        <div class="card-body">

            <form asp-action="Create" method="post">

                <partial name="_BedroomTypeForm" model="Model" />

                <button type="submit" class="btn btn-primary">
                    Guardar
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Cancelar
                </a>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
