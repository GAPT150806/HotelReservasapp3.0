@model HotelReservasapp_.WebApp.Models.ViewModels.BedroomTypes.BedroomTypeViewModel

<div asp-validation-summary="ModelOnly"
     class="text-danger mb-3"></div>

<div class="mb-3">
    <label asp-for="Nombre" class="form-label"></label>

    <input asp-for="Nombre"
           class="form-control"
           placeholder="Ejemplo: Individual, Doble, Suite" />

    <span asp-validation-for="Nombre"
          class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Caracteristicas" class="form-label"></label>

    <textarea asp-for="Caracteristicas"
              class="form-control"
              rows="4"
              placeholder="Describa las características del tipo de habitación"></textarea>

    <span asp-validation-for="Caracteristicas"
          class="text-danger"></span>
</div>
