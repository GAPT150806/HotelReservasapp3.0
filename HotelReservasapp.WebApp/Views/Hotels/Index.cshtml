@model IEnumerable<HotelReservasapp_.WebApp.Models.ViewModels.Hotels.HotelViewModel>
@using HotelReservasapp.BusinessLogic.Enums

@{
    ViewData["Title"] = "Hoteles";
}

<div class="management-page">

    <div class="management-toolbar">
        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-lg me-1"></i>
            Registrar hotel
        </a>
    </div>

    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="alert alert-success alert-dismissible fade show compact-alert">
            @success
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="alert alert-danger alert-dismissible fade show compact-alert">
            @error
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="management-card">

        <div class="management-card-header">
            <div>
                <h5>Hoteles registrados</h5>
                <span>Consulta y administra los hoteles del sistema.</span>
            </div>

            <span class="management-count">
                @Model.Count() registros
            </span>
        </div>

        @if (!Model.Any())
        {
            <div class="management-empty">
                <i class="bi bi-building"></i>
                <h6>No hay hoteles registrados</h6>
                <p>Registra un hotel para comenzar a administrar su estructura.</p>

                <a asp-action="Create" class="btn btn-primary btn-sm">
                    <i class="bi bi-plus-lg me-1"></i>
                    Registrar hotel
                </a>
            </div>
        }
        else
        {
            <div class="management-table-tools">
                <div class="table-search management-search">
                    <span><i class="bi bi-search"></i></span>
                    <input type="search"
                           class="form-control"
                           data-table-search
                           placeholder="Buscar hotel por nombre o ID..." />
                </div>

                <span class="table-result-count" data-table-count></span>
            </div>

            <div class="table-responsive">
                <table class="table management-table"
                       data-enhanced-table>

                    <thead>
                        <tr>
                            <th data-sortable>Hotel</th>
                            <th data-sortable>Teléfono</th>
                            <th data-sortable>Dirección</th>
                            <th data-sortable>Estado</th>
                            <th class="text-end" data-no-sort>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var hotel in Model)
                        {
                            <tr>
                                <td>
                                    <div class="management-primary-cell">
                                        <span class="management-row-icon">
                                            <i class="bi bi-building"></i>
                                        </span>
                                        <strong>@hotel.Nombre</strong>
                                    </div>
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(hotel.Telefono)
                                        ? "—" : hotel.Telefono)
                                </td>

                                <td class="management-address">
                                    @(string.IsNullOrWhiteSpace(hotel.Direccion)
                                        ? "—" : hotel.Direccion)
                                </td>

                                <td>
                                    @if (hotel.Estado == GeneralState.Activo)
                                    {
                                        <span class="management-status status-active">
                                            <span></span> Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="management-status status-inactive">
                                            <span></span> Inactivo
                                        </span>
                                    }
                                </td>

                                <td>
                                    <div class="management-actions">

                                        <a asp-action="Edit"
                                           asp-route-id="@hotel.Id"
                                           class="btn-action btn-action-edit"
                                           title="Editar hotel">
                                            <i class="bi bi-pencil"></i>
                                            <span>Editar</span>
                                        </a>

                                        <form asp-action="ChangeState"
                                              asp-route-id="@hotel.Id"
                                              method="post">

                                            <input type="hidden"
                                                   name="estado"
                                                   value="@(hotel.Estado == GeneralState.Activo
                                                        ? GeneralState.Inactivo
                                                        : GeneralState.Activo)" />

                                            @if (hotel.Estado == GeneralState.Activo)
                                            {
                                                <button type="submit"
                                                        class="btn-action btn-action-danger"
                                                        title="Desactivar hotel">
                                                    <i class="bi bi-power"></i>
                                                    <span>Desactivar</span>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit"
                                                        class="btn-action btn-action-success"
                                                        title="Activar hotel">
                                                    <i class="bi bi-check-circle"></i>
                                                    <span>Activar</span>
                                                </button>
                                            }
                                        </form>

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        }

    </div>

</div>
