@model IEnumerable<HotelReservasapp_.WebApp.Models.ViewModels.Hotels.HotelViewModel>
@using HotelReservasapp.BusinessLogic.Enums

@{
    ViewData["Title"] = "Hoteles";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Hoteles</h2>
            <p class="text-muted mb-0">
                Administración de hoteles registrados.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            Registrar hotel
        </a>
    </div>

    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="alert alert-success">@success</div>
    }

    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="alert alert-danger">@error</div>
    }

    <div class="card shadow-sm">
        <div class="card-body">

            @if (!Model.Any())
            {
                <p class="text-muted mb-0">
                    No hay hoteles registrados.
                </p>
            }
            else
            {
                
                <div class="table-tools">
                    <div class="table-search">
                        <span>⌕</span>
                        <input type="search"
                               class="form-control"
                               data-table-search
                               placeholder="Buscar hotel por nombre o ID..." />
                    </div>

                    <span class="table-result-count" data-table-count></span>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle" data-enhanced-table>

                        <thead>
                            <tr>
                                <th data-sortable>ID</th>
                                <th data-sortable>Nombre</th>
                                <th data-sortable>Estado</th>
                                <th class="text-end" data-no-sort>Acciones</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var hotel in Model)
                            {
                                <tr>
                                    <td>@hotel.Id</td>
                                    <td>@hotel.Nombre</td>

                                    <td>
                                        @if (hotel.Estado == GeneralState.Activo)
                                        {
                                            <span class="badge bg-success">
                                                Activo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Inactivo
                                            </span>
                                        }
                                    </td>

                                    <td class="text-end">
                                        <a asp-action="Edit"
                                           asp-route-id="@hotel.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Editar
                                        </a>

                                        <form asp-action="ChangeState"
                                              asp-route-id="@hotel.Id"
                                              method="post"
                                              class="d-inline">

                                            <input type="hidden"
                                                   name="estado"
                                                   value="@(hotel.Estado == GeneralState.Activo ? GeneralState.Inactivo : GeneralState.Activo)" />

                                            @if (hotel.Estado == GeneralState.Activo)
                                            {
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger">
                                                    Desactivar
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-success">
                                                    Activar
                                                </button>
                                            }

                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            }

        </div>
    </div>
</div>
