
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light">

    <title>@ViewData["Title"] - Hotel LosBros</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HotelReservasapp_.WebApp.styles.css" asp-append-version="true" />
</head>

<body>

    <div class="app-shell">

        <!-- Fondo para cerrar el menú en móviles -->
        <div class="sidebar-overlay" id="sidebarOverlay"></div>

        <!-- MENÚ LATERAL -->
        <aside class="app-sidebar" id="appSidebar">

            <a asp-controller="Home"
               asp-action="Index"
               class="sidebar-brand">

                <span class="brand-logo">H</span>

                <span class="brand-info">
                    <strong>Hotel LosBros</strong>
                    <small>Sistema de gestión</small>
                </span>

            </a>

            <div class="sidebar-section-title">
                MENÚ PRINCIPAL
            </div>

            <nav class="sidebar-nav">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="sidebar-link @(currentController == "Home" ? "active" : "")">
                    <span class="nav-icon">⌂</span>
                    <span>Inicio</span>
                </a>

                <a asp-controller="Hotels"
                   asp-action="Index"
                   class="sidebar-link @(currentController == "Hotels" ? "active" : "")">
                    <span class="nav-icon">▤</span>
                    <span>Hoteles</span>
                </a>

                <a asp-controller="Floors"
                   asp-action="Index"
                   class="sidebar-link @(currentController == "Floors" ? "active" : "")">
                    <span class="nav-icon">▥</span>
                    <span>Pisos</span>
                </a>

                <a asp-controller="Bedrooms"
                   asp-action="Index"
                   class="sidebar-link @(currentController == "Bedrooms" ? "active" : "")">
                    <span class="nav-icon">▦</span>
                    <span>Habitaciones</span>
                </a>

                <a asp-controller="BedroomTypes"
                   asp-action="Index"
                   class="sidebar-link @(currentController == "BedroomTypes" ? "active" : "")">
                    <span class="nav-icon">◇</span>
                    <span>Tipos de habitaciones</span>
                </a>

            </nav>

            <div class="sidebar-footer">
                <span class="sidebar-footer-icon">●</span>
                <span>Sistema administrativo</span>
            </div>

        </aside>

        <!-- CONTENIDO PRINCIPAL -->
        <div class="app-main">

            <header class="app-header">

                <div class="header-left">

                    <button type="button"
                            class="mobile-menu-btn"
                            id="sidebarToggle"
                            aria-label="Abrir menú"
                            aria-expanded="false">
                        ☰
                    </button>

                    <div>
                        <h1>@ViewData["Title"]</h1>
                        <p>Hotel LosBros · Sistema de gestión</p>
                    </div>

                </div>

                <div class="header-right">
                    <span class="header-date">
                        @DateTime.Now.ToString("dd/MM/yyyy")
                    </span>
                </div>

            </header>

            <main class="app-content">
                @RenderBody()
            </main>

            <footer class="app-footer">
                <span>© @DateTime.Now.Year HotelLosBros</span>
            </footer>

        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
