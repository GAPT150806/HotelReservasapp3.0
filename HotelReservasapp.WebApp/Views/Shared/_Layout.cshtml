
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light">

    <title>@ViewData["Title"] - Hotel LosBros</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HotelReservasapp_.WebApp.styles.css" asp-append-version="true" />
</head>

<body>

    <div class="app-shell">

        <!-- Fondo para cerrar el menú en móviles -->
        <div class="sidebar-overlay" id="sidebarOverlay"></div>

        <!-- MENÚ LATERAL -->
        <aside class="app-sidebar" id="appSidebar">

            <a asp-controller="Home"
               asp-action="Index"
               class="sidebar-brand">

                <span class="brand-logo">H</span>

                <span class="brand-info">
                    <strong>Hotel LosBros</strong>
                    <small>Sistema de gestión</small>
                </span>

            </a>

            <div class="sidebar-section-title">
                MENÚ PRINCIPAL
            </div>


            <nav class="sidebar-nav">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="sidebar-link @(currentController == "Home" ? "active" : "")">
                    <i class="bi bi-house-door"></i>
                    <span>Inicio</span>
                </a>

                <a asp-controller="Hotels"
                   asp-action="Index"
                   class="sidebar-link @(currentController == "Hotels" ? "active" : "")">
                    <i class="bi bi-buildings"></i>
                    <span>Hoteles</span>
                </a>

                <a asp-controller="Floors"
                   asp-action="Index"
                   class="sidebar-link @(currentController == "Floors" ? "active" : "")">
                    <i class="bi bi-layers"></i>
                    <span>Pisos</span>
                </a>

                <a asp-controller="Bedrooms"
                   asp-action="Index"
                   class="sidebar-link @(currentController == "Bedrooms" ? "active" : "")">
                    <i class="bi bi-door-closed"></i>
                    <span>Habitaciones</span>
                </a>

                <a asp-controller="BedroomTypes"
                   asp-action="Index"
                   class="sidebar-link @(currentController == "BedroomTypes" ? "active" : "")">
                    <i class="bi bi-grid-3x3-gap"></i>
                    <span>Tipos de habitaciones</span>
                </a>

                <a asp-controller="Guests"
                   asp-action="Index"
                   class="sidebar-link @(currentController == "Guests" ? "active" : "")">
                    <i class="bi bi-people"></i>
                    <span>Huéspedes</span>
                </a>

                <a asp-controller="Availability"
                   asp-action="Index"
                   class="sidebar-link @(currentController == "Availability" ? "active" : "")">
                    <i class="bi bi-calendar2-check"></i>
                    <span>Disponibilidad</span>
                </a>

                <a asp-controller="Reservations"
                   asp-action="Index"
                   class="sidebar-link @(currentController == "Reservations" ? "active" : "")">
                    <i class="bi bi-journal-check"></i>
                    <span>Reservas</span>
                </a>

            </nav>




        </aside>

        <!-- CONTENIDO PRINCIPAL -->
        <div class="app-main">

            <header class="app-header">

                <div class="header-left">

                    <button type="button"
                            class="mobile-menu-btn"
                            id="sidebarToggle"
                            aria-label="Abrir menú"
                            aria-expanded="false">
                        ☰
                    </button>

                    <div>
                        <h1>@ViewData["Title"]</h1>
                    </div>

                </div>


                <div class="header-right">
                    <div class="header-user">
                        <svg xmlns="http://www.w3.org/2000/svg"
                             width="21"
                             height="21"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round">
                            <circle cx="12" cy="8" r="4"></circle>
                            <path d="M5 21a7 7 0 0 1 14 0"></path>
                        </svg>

                        <span>Administrador</span>
                    </div>
                </div>


            </header>

            <main class="app-content">
                @RenderBody()
            </main>

            <footer class="app-footer">
                <span>© @DateTime.Now.Year HotelLosBros</span>
            </footer>

        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
