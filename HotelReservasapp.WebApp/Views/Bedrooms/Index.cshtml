
@model IEnumerable<HotelReservasapp_.WebApp.Models.ViewModels.Bedrooms._BedroomForm>
@using HotelReservasapp.BusinessLogic.Enums

@{
    ViewData["Title"] = "Habitaciones";
}

@functions {
    public static string EstadoNombre(BedroomState estado)
    {
        return estado switch
        {
            BedroomState.Disponible => "Disponible",
            BedroomState.Reservada => "Reservada",
            BedroomState.Ocupada => "Ocupada",
            BedroomState.Limpieza => "Limpieza",
            BedroomState.Mantenimiento => "Mantenimiento",
            BedroomState.FueraServicio => "Fuera de servicio",
            _ => "Desconocido"
        };
    }
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Habitaciones</h2>
            <p class="text-muted mb-0">
                Administración de habitaciones de los hoteles.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            Registrar habitación
        </a>
    </div>

    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="alert alert-success">@success</div>
    }

    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="alert alert-danger">@error</div>
    }

    <div class="card shadow-sm">
        <div class="card-body">

            @if (!Model.Any())
            {
                <p class="text-muted mb-0">
                    No hay habitaciones registradas.
                </p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Hotel</th>
                                <th>Piso</th>
                                <th>Número</th>
                                <th>Tipo</th>
                                <th>Capacidad</th>
                                <th>Tarifa por noche</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var bedroom in Model)
                            {
                                <tr>
                                    <td>@bedroom.HotelNombre</td>
                                    <td>@bedroom.PisoNombre</td>
                                    <td>@bedroom.Numero</td>
                                    <td>@bedroom.TipoNombre</td>
                                    <td>@bedroom.Capacidad</td>
                                    <td>@bedroom.TarifaPorNoche.ToString("N2")</td>

                                    <td>
                                        @switch (bedroom.Estado)
                                        {
                                            case BedroomState.Disponible:
                                                <span class="badge bg-success">Disponible</span>
                                                break;

                                            case BedroomState.Reservada:
                                                <span class="badge bg-primary">Reservada</span>
                                                break;

                                            case BedroomState.Ocupada:
                                                <span class="badge bg-info text-dark">Ocupada</span>
                                                break;

                                            case BedroomState.Limpieza:
                                                <span class="badge bg-warning text-dark">Limpieza</span>
                                                break;

                                            case BedroomState.Mantenimiento:
                                                <span class="badge bg-secondary">Mantenimiento</span>
                                                break;

                                            case BedroomState.FueraServicio:
                                                <span class="badge bg-danger">Fuera de servicio</span>
                                                break;
                                        }
                                    </td>

                                    <td>
                                        <div class="d-flex gap-1">

                                            <a asp-action="Edit"
                                               asp-route-id="@bedroom.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                Editar
                                            </a>

                                            <form asp-action="ChangeState"
                                                  asp-route-id="@bedroom.Id"
                                                  method="post"
                                                  class="d-flex gap-1">

                                                <select name="estado"
                                                        class="form-select form-select-sm"
                                                        style="min-width: 145px">

                                                    @foreach (BedroomState state in Enum.GetValues<BedroomState>())
                                                    {
                                                        <option value="@state"
                                                                selected="@(state == bedroom.Estado ? "selected" : null)">
                                                            @EstadoNombre(state)
                                                        </option>
                                                    }
                                                </select>

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-secondary">
                                                    Cambiar
                                                </button>

                                            </form>

                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            }

        </div>
    </div>
</div>
