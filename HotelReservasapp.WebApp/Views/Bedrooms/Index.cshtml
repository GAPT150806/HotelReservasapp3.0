
@model IEnumerable<HotelReservasapp_.WebApp.Models.ViewModels.Bedrooms.BedroomViewModel>
@using HotelReservasapp.BusinessLogic.Enums

@{
    ViewData["Title"] = "Habitaciones";
}

@functions {
    public static string EstadoNombre(BedroomState estado)
    {
        return estado switch
        {
            BedroomState.Disponible => "Disponible",
            BedroomState.Reservada => "Reservada",
            BedroomState.Ocupada => "Ocupada",
            BedroomState.Limpieza => "Limpieza",
            BedroomState.Mantenimiento => "Mantenimiento",
            BedroomState.FueraServicio => "Fuera de servicio",
            _ => "Desconocido"
        };
    }

    public static string EstadoCss(BedroomState estado)
    {
        return estado switch
        {
            BedroomState.Disponible => "bg-success",
            BedroomState.Reservada => "bg-primary",
            BedroomState.Ocupada => "bg-info text-dark",
            BedroomState.Limpieza => "bg-warning text-dark",
            BedroomState.Mantenimiento => "bg-secondary",
            BedroomState.FueraServicio => "bg-danger",
            _ => "bg-dark"
        };
    }
}

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Habitaciones</h2>
            <p class="text-muted mb-0">
                Administración de habitaciones de los hoteles.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + Registrar habitación
        </a>
    </div>

    <div data-state-feedback
         class="alert d-none"
         role="status"
         aria-live="polite">
    </div>

    
    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>Correcto:</strong> @successMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Error:</strong> @errorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }


    <div class="card shadow-sm">
        <div class="card-body">

            @if (!Model.Any())
            {
                <p class="text-muted mb-0">
                    No hay habitaciones registradas.
                </p>
            }
            else
            {
                <div class="table-tools">
                    <div class="table-search">
                        <span>⌕</span>

                        <input type="search"
                               class="form-control"
                               data-table-search
                               placeholder="Buscar por hotel, piso, número, tipo o estado..." />
                    </div>

                    <span class="table-result-count"
                          data-table-count></span>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle"
                           data-enhanced-table>

                        <thead>
                            <tr>
                                <th data-sortable>Hotel</th>
                                <th data-sortable>Piso</th>
                                <th data-sortable>Número</th>
                                <th data-sortable>Tipo</th>
                                <th data-sortable>Capacidad</th>
                                <th data-sortable>Tarifa por noche</th>
                                <th data-sortable>Estado</th>
                                <th data-no-sort>Acciones</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var bedroom in Model)
                            {
                                <tr data-bedroom-row="@bedroom.Id">

                                    <td>@bedroom.HotelNombre</td>
                                    <td>@bedroom.PisoNombre</td>
                                    <td>@bedroom.Numero</td>
                                    <td>@bedroom.TipoNombre</td>
                                    <td>@bedroom.Capacidad</td>
                                    <td>@bedroom.TarifaPorNoche.ToString("N2")</td>

                                    <td>
                                        <span class="badge @EstadoCss(bedroom.Estado)"
                                              data-state-badge>
                                            @EstadoNombre(bedroom.Estado)
                                        </span>
                                    </td>

                                    <td>
                                        <div class="d-flex align-items-center gap-2">

                                            <a asp-action="Edit"
                                               asp-route-id="@bedroom.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                Editar
                                            </a>

                                            <form asp-action="ChangeState"
                                                  asp-route-id="@bedroom.Id"
                                                  method="post"
                                                  class="state-change-form">

                                                @Html.AntiForgeryToken()

                                                <select name="estado"
                                                        class="form-select form-select-sm state-select">

                                                    @foreach (BedroomState state in Enum.GetValues<BedroomState>())
                                                    {
                                                        <option value="@state"
                                                                selected="@(state == bedroom.Estado)">
                                                            @EstadoNombre(state)
                                                        </option>
                                                    }

                                                </select>

                                                <button type="submit" class="btn btn-sm btn-primary">
                                                    Cambiar
                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            }

        </div>
    </div>
</div>
