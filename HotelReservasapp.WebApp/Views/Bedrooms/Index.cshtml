@model IEnumerable<HotelReservasapp_.WebApp.Models.ViewModels.Bedrooms.BedroomViewModel>
@using HotelReservasapp.BusinessLogic.Enums

@{
    ViewData["Title"] = "Habitaciones";
}

@functions {
    public static string EstadoNombre(BedroomState estado) => estado switch
    {
        BedroomState.Disponible => "Disponible",
        BedroomState.Reservada => "Reservada",
        BedroomState.Ocupada => "Ocupada",
        BedroomState.Limpieza => "Limpieza",
        BedroomState.Mantenimiento => "Mantenimiento",
        BedroomState.FueraServicio => "Fuera de servicio",
        _ => "Desconocido"
    };

    public static string EstadoCss(BedroomState estado) => estado switch
    {
        BedroomState.Disponible => "status-active",
        BedroomState.Reservada => "status-reserved",
        BedroomState.Ocupada => "status-occupied",
        BedroomState.Limpieza => "status-cleaning",
        BedroomState.Mantenimiento => "status-maintenance",
        BedroomState.FueraServicio => "status-inactive",
        _ => "status-inactive"
    };
}

<div class="management-page">

    <div class="management-toolbar">

        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-lg me-1"></i> Registrar habitación
        </a>
    </div>

    <div data-state-feedback class="alert d-none" role="status" aria-live="polite"></div>

    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="alert alert-success compact-alert">@success</div>
    }

    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="alert alert-danger compact-alert">@error</div>
    }

    <div class="management-card">

        <div class="management-card-header">
            <div>
                <h5>Habitaciones registradas</h5>
                <span>Consulta y administra las habitaciones de los hoteles.</span>
            </div>
            <span class="management-count">@Model.Count() registros</span>
        </div>

        @if (!Model.Any())
        {
            <div class="management-empty">
                <i class="bi bi-door-closed"></i>
                <h6>No hay habitaciones registradas</h6>
                <p>Registra una habitación para comenzar.</p>
            </div>
        }
        else
        {
            <div class="management-table-tools">
                <div class="table-search management-search">
                    <span><i class="bi bi-search"></i></span>
                    <input type="search" class="form-control"
                           data-table-search
                           placeholder="Buscar por hotel, piso, número, tipo o estado..." />
                </div>
                <span class="table-result-count" data-table-count></span>
            </div>

            <div class="table-responsive">
                <table class="table management-table" data-enhanced-table>
                    <thead>
                        <tr>
                            <th data-sortable>Hotel</th>
                            <th data-sortable>Piso</th>
                            <th data-sortable>Habitación</th>
                            <th data-sortable>Tipo</th>
                            <th data-sortable>Capacidad</th>
                            <th data-sortable>Tarifa por noche</th>
                            <th data-sortable>Estado</th>
                            <th data-no-sort class="text-end">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var bedroom in Model)
                        {
                            <tr data-bedroom-row="@bedroom.Id">
                                <td>@bedroom.HotelNombre</td>
                                <td>@bedroom.PisoNombre</td>

                                <td>
                                    <div class="management-primary-cell">
                                        <span class="management-row-icon">
                                            <i class="bi bi-door-open"></i>
                                        </span>
                                        <strong>@bedroom.Numero</strong>
                                    </div>
                                </td>

                                <td>@bedroom.TipoNombre</td>
                                <td>@bedroom.Capacidad huéspedes</td>
                                <td>@bedroom.TarifaPorNoche.ToString("C")</td>

                                <td>
                                    <span class="management-status @EstadoCss(bedroom.Estado)"
                                          data-state-badge>
                                        <span></span>
                                        @EstadoNombre(bedroom.Estado)
                                    </span>
                                </td>

                                <td>
                                    <div class="management-actions">
                                        <a asp-action="Edit"
                                           asp-route-id="@bedroom.Id"
                                           class="btn-action btn-action-edit">
                                            <i class="bi bi-pencil"></i> Editar
                                        </a>

                                        <form asp-action="ChangeState"
                                              asp-route-id="@bedroom.Id"
                                              method="post"
                                              class="state-change-form">

                                            @Html.AntiForgeryToken()

                                            <select name="estado"
                                                    class="form-select form-select-sm state-select">
                                                @foreach (BedroomState state in Enum.GetValues<BedroomState>())
                                                {
                                                    <option value="@state"
                                                            selected="@(state == bedroom.Estado)">
                                                        @EstadoNombre(state)
                                                    </option>
                                                }
                                            </select>

                                            <button type="submit"
                                                    class="btn-action btn-action-edit">
                                                Cambiar
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
