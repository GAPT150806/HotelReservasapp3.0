@model HotelReservasapp_.WebApp.Models.ViewModels.Floors.FloorViewModel

@{
    ViewData["Title"] = "Editar piso";
}

<div class="container mt-4">
    <h2>Editar piso</h2>
    <p class="text-muted">Modifique el número del piso.</p>

    <div class="card shadow-sm">
        <div class="card-body">

            <form asp-action="Edit"
                  asp-route-id="@Model.Id"
                  method="post">

                <input asp-for="Id" type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label class="form-label">Hotel</label>

                    <input value="@Model.HotelNombre"
                           class="form-control"
                           readonly />
                </div>

                <div class="mb-3">
                    <label asp-for="Numero" class="form-label"></label>

                    <input asp-for="Numero"
                           type="number"
                           min="1"
                           class="form-control" />

                    <span asp-validation-for="Numero"
                          class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">
                    Guardar cambios
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Cancelar
                </a>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
